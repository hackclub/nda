#!/usr/bin/env ruby

require "rbconfig"

def bundle_command(*arguments)
  lockfile = File.read(File.expand_path("../Gemfile.lock", __dir__))
  version = lockfile.match(/^BUNDLED WITH\n\s+(\S+)$/)&.captures&.first
  abort "Gemfile.lock does not declare a Bundler version" unless version

  bundle = File.join(
    ENV.fetch("BUNDLE_PATH"),
    "ruby",
    RbConfig::CONFIG.fetch("ruby_version"),
    "gems",
    "bundler-#{version}",
    "exe",
    "bundle"
  )
  abort "Bundler #{version} is not installed" unless File.file?(bundle)

  [RbConfig.ruby, bundle, *arguments]
end

if ARGV.each_cons(2).any? { |left, right| left.end_with?("rails") && right == "server" }
  storage_service = ENV.fetch("ACTIVE_STORAGE_SERVICE", "cloudflare")
  abort "ACTIVE_STORAGE_SERVICE must be cloudflare in production." unless storage_service == "cloudflare"

  required = %w[
    SECRET_KEY_BASE DATABASE_URL APP_HOST
    HACK_CLUB_CLIENT_ID HACK_CLUB_CLIENT_SECRET HACK_CLUB_REDIRECT_URI
    XAI_API_KEY SLACK_BOT_TOKEN
    AIRTABLE_TOKEN AIRTABLE_BASE_ID AIRTABLE_TABLE_ID
    R2_ACCESS_KEY_ID R2_SECRET_ACCESS_KEY R2_ENDPOINT R2_BUCKET R2_SSE_CUSTOMER_KEY
    LOOPS_API_KEY LOOPS_IMPORT_CHALLENGE_TRANSACTIONAL_ID LOOPS_IMPORT_SETTLED_TRANSACTIONAL_ID
    LOOPS_IMPORT_REJECTED_TRANSACTIONAL_ID LOOPS_IMPORT_NEEDS_REVIEW_TRANSACTIONAL_ID
    LOOPS_SIGNATURE_RECEIPT_TRANSACTIONAL_ID LOOPS_COSIGN_REQUEST_TRANSACTIONAL_ID
    LOOPS_COSIGN_RECEIPT_TRANSACTIONAL_ID
  ]

  required.each do |name|
    next unless ENV[name].to_s.empty?
    abort "#{name} is not set. This app is configured entirely through environment variables; " \
          "see the deployment section of README.md."
  end

  key_length = ENV["R2_SSE_CUSTOMER_KEY"].to_s.length
  abort "R2_SSE_CUSTOMER_KEY must be exactly 32 characters, got #{key_length}." unless
    key_length.zero? || key_length == 32

  abort "Database preparation failed" unless system(*bundle_command("exec", "rails", "db:prepare"))
end

if ARGV.first == "bundle"
  exec(*bundle_command(*ARGV.drop(1)))
else
  exec(*ARGV)
end
