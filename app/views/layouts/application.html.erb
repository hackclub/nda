<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <title><%= content_for(:title) || "Hack Club NDA" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#ec3750">
    <link rel="icon" href="https://assets.hackclub.com/icon-rounded.png" type="image/png">
    <%= csrf_meta_tags %><%= csp_meta_tag %>
    <%= vite_client_tag %><%= vite_javascript_tag "application" %>
  </head>
  <body class="<%= content_for(:body_class) %>">
    <header class="site-header">
      <%= link_to root_path, class: "brand" do %><%= image_tag "hack-club-icon-rounded.png", class: "brand-mark", alt: "" %><span>Hack Club NDA</span><% end %>
      <% if current_user %><div class="account"><span><%= current_user.display_name %></span><%= link_to "Admin", admin_root_path, class: "admin-link" if current_user.admin_access? %><%= button_to "Sign out", logout_path, method: :delete, class: "link-button" %></div><% end %>
    </header>
    <% if notice %><div class="flash flash-notice"><%= notice %></div><% end %>
    <% if alert %><div class="flash flash-alert"><%= alert %></div><% end %>
    <main><%= yield %></main>
  </body>
</html>
